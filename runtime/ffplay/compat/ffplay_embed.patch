+
+#ifdef FFPLAY_EMBED
+/* ================= 嵌入引擎 API (ffplay_embed.patch 新增, 非上游) =================
+ * 目标: 复用 ffplay 全部播放能力 (解码/同步/音频/seek), 提供最小嵌入接口。
+ * 控制语义与 LO avmedia XPlayer 对齐 (start/stop/pause/seek/volume/loop)。
+ * 多实例: 每实例独立 VideoState (window/renderer per-instance);
+ *         渲染入口 (video_display) 同步全局句柄, 各实例渲染线程互不干扰。
+ * 刷新机制: 复刻 refresh_loop_wait_event 轮询语义 (定制版无 FF_REFRESH_EVENT)。
+ */
+static int ffplay_engine_pump_thread(void *arg)
+{
+    VideoState *is = arg;
+    while (!is->abort_request) {
+        SDL_Event event;
+        SDL_PumpEvents();
+        if (SDL_PeepEvents(&event, 1, SDL_GETEVENT, SDL_FIRSTEVENT, SDL_LASTEVENT)) {
+            if (event.type == SDL_QUIT)
+                is->abort_request = 1;
+            continue;
+        }
+        double remaining_time = 0.0;
+        if (is->show_mode != SHOW_MODE_NONE && (!is->paused || is->force_refresh))
+            video_refresh(is, &remaining_time);
+        if (remaining_time > 0.0)
+            av_usleep((int64_t)(remaining_time * 1000000.0));
+        else
+            SDL_Delay(1);
+    }
+    return 0;
+}
+
+void *ffplay_engine_create(const char *url, void *parent_window)
+{
+    /* 全局默认值 (与官方 ffplay 默认一致; 选项在嵌入模式固定) */
+    loop = 1;
+    autoexit = 0;
+    show_status = 0;
+    startup_volume = 100;
+    av_sync_type = AV_SYNC_AUDIO_MASTER;
+    framedrop = -1;
+    infinite_buffer = -1;
+    lowres = 0;
+    genpts = 0;
+    find_stream_info = 1;
+
+    if (!SDL_WasInit(SDL_INIT_VIDEO | SDL_INIT_AUDIO | SDL_INIT_TIMER)) {
+        if (SDL_Init(SDL_INIT_VIDEO | SDL_INIT_AUDIO | SDL_INIT_TIMER)) {
+            av_log(NULL, AV_LOG_FATAL, "Could not initialize SDL - %s\n", SDL_GetError());
+            return NULL;
+        }
+        /* 多实例根治: 进程级渲染锁, 随 SDL 首次 init 创建一次 (创建串行由 BootLock/500ms 错峰保证, 经验 37 ④) */
+        render_mutex = SDL_CreateMutex();
+    }
+    /* 禁用 SDL 窗口 framebuffer 的 GL 加速 fallback: SW 软件渲染器的
+       present 链 (SW_RenderPresent → SDL_UpdateWindowSurface →
+       SDL_CreateWindowFramebuffer) 默认尝试 texture framebuffer —— 内部
+       循环显式跳过 software 驱动、只找 ACCELERATED 渲染器 (SDL_video.c
+       ShouldAttemptTextureFramebuffer / SDL_CreateWindowTexture, 不读
+       SDL_HINT_RENDER_DRIVER), Xvfb 的 mesa 软件 GLX 下创建 swrast 上下文;
+       单实例单线程 JIT 侥幸存活 (慢), 双实例并发 LLVM JIT 直接 abort
+       (2026-08-17 dual_media.pptx 实测定位)。SDL_HINT_FRAMEBUFFER_
+       ACCELERATION=0 使该函数返回 FALSE → 走 X11 原生 XShm 路径, GL
+       完全不加载 (Xvfb 恒无 GPU, 经验 19b) */
+    SDL_SetHint(SDL_HINT_FRAMEBUFFER_ACCELERATION, "0");
+    avformat_network_init();
+
+    ffplay_embed_parent_window = parent_window;
+    VideoState *is = stream_open(url, NULL);
+    if (!is) {
+        av_log(NULL, AV_LOG_FATAL, "Failed to initialize VideoState!\n");
+        return NULL;
+    }
+    is->pump_tid = SDL_CreateThread(ffplay_engine_pump_thread, "ffplay_pump", is);
+    if (!is->pump_tid) {
+        do_exit(is);
+        return NULL;
+    }
+    return is;
+}
+
+void ffplay_engine_destroy(void *handle)
+{
+    VideoState *is = handle;
+    if (!is)
+        return;
+    is->abort_request = 1;
+    if (is->pump_tid)
+        SDL_WaitThread(is->pump_tid, NULL);
+    do_exit(is); /* 嵌入版 do_exit: 清理但不退出进程/不 SDL_Quit */
+}
+
+void ffplay_engine_play(void *handle)
+{
+    VideoState *is = handle;
+    if (is && is->paused)
+        stream_toggle_pause(is);
+}
+
+void ffplay_engine_pause(void *handle)
+{
+    VideoState *is = handle;
+    if (is && !is->paused)
+        stream_toggle_pause(is);
+}
+
+int ffplay_engine_is_playing(void *handle)
+{
+    VideoState *is = handle;
+    return is && !is->paused && !is->abort_request;
+}
+
+void ffplay_engine_seek(void *handle, double seconds)
+{
+    VideoState *is = handle;
+    if (is)
+        stream_seek(is, (int64_t)(seconds * AV_TIME_BASE), 0, 0);
+}
+
+double ffplay_engine_get_media_time(void *handle)
+{
+    VideoState *is = handle;
+    if (!is)
+        return 0.0;
+    double t = get_master_clock(is);
+    /* 时钟未初始化 (新实例创建瞬间/流未启动) 时 get_master_clock 返回 nan,
+       归零避免 nan 传播到上层 (2026-08-17 落地) */
+    return isnan(t) ? 0.0 : t;
+}
+
+double ffplay_engine_get_duration(void *handle)
+{
+    VideoState *is = handle;
+    if (!is || !is->ic)
+        return 0.0;
+    return is->ic->duration == AV_NOPTS_VALUE ? 0.0 : (double)is->ic->duration / AV_TIME_BASE;
+}
+
+void ffplay_engine_set_loop(void *handle, int count)
+{
+    VideoState *is = handle;
+    if (is)
+        loop = count; /* 全局选项 (与官方 ffplay 一致, 嵌入固定) */
+}
+
+/* 调试: 打印内部时钟/队列状态 (探针用) */
+void ffplay_engine_debug(void *handle)
+{
+    VideoState *is = handle;
+    if (!is)
+        return;
+    /* ENGINE-DBG 探针调试: av_log debug 级 (ORT_LOG_LEVEL=debug 才输出) */
+    av_log(NULL, AV_LOG_DEBUG, "[ENGINE-DBG] paused=%d audio_clock=%f isnan=%d audclk.serial=%d audioq.serial=%d vidclk.serial=%d videoq.serial=%d seek_req=%d\n",
+            is->paused, is->audio_clock, isnan(is->audio_clock) ? 1 : 0,
+            is->audclk.serial, is->audioq.serial,
+            is->vidclk.serial, is->videoq.serial, is->seek_req);
+}
+
+void ffplay_engine_get_window_size(void *handle, int *w, int *h)
+{
+    VideoState *is = handle;
+    if (!is) {
+        if (w) *w = 0;
+        if (h) *h = 0;
+        return;
+    }
+    if (w) *w = is->width;
+    if (h) *h = is->height;
+}
+
+void ffplay_engine_set_volume(void *handle, int percent)
+{
+    VideoState *is = handle;
+    if (!is)
+        return;
+    if (percent < 0) percent = 0;
+    if (percent > 100) percent = 100;
+    is->audio_volume = percent * SDL_MIX_MAXVOLUME / 100;
+}
+
+int ffplay_engine_get_volume(void *handle)
+{
+    VideoState *is = handle;
+    if (!is)
+        return -1;
+    return is->audio_volume * 100 / SDL_MIX_MAXVOLUME;
 }
